# Copy this file to .env. You need a key for the provider you use.
# Direct Anthropic (default): key from https://platform.claude.com
ANTHROPIC_API_KEY=
# OpenRouter (--provider openrouter): set it with `bash scripts/set-openrouter-key.sh`
# so the key never appears on screen. Don't paste keys into chats.
OPENROUTER_API_KEY=

# Mock mode only: how often fake workers return broken output (0.0–1.0)
MOCK_FAIL_RATE=0.15

# Optional: web search tool version and searches allowed per call
# WEB_SEARCH_TOOL_VERSION=web_search_20260209
# WEB_SEARCH_MAX_USES=3
